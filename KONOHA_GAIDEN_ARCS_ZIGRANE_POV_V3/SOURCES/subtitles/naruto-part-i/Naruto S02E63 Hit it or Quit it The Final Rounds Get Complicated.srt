287
00:21:32,450 --> 00:21:38,620
<font face="DeschTypeMercurius-Medium" size="23">{\an8}<font size="20"><b><font face="Oravetica"><font color="#bff49b">OH YEAH OH YEAH OH YEAH</font></font></b></font></font>


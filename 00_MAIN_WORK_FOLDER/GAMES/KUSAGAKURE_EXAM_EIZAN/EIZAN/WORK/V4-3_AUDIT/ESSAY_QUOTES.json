      221
    ]
  },
  {
    "id": "E02",
    "quote": "Я лишив їх там, де вони не лізли під ноги, і сам пішов по сліду",
    "exact": true,
    "occurrences": 1,
    "lines": [
      223
    ]
  },
  {
    "id": "E03",
    "quote": "Не журися. Пастки — моя робота. Ще б я свого не взяв. Тобі з ними важче",
    "exact": true,
    "occurrences": 1,
    "lines": [
      257
    ]
  },
  {
    "id": "E04",
    "quote": "Я не заслужив",
